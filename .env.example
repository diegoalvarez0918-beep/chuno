# Solo para desarrollo local con `wrangler dev`.
# En producción NADA de esto vive aquí: son secretos de Cloudflare.
#   npx wrangler secret put GEMINI_API_KEY
#
# Copiar a .dev.vars (ignorado por git). NUNCA commitear valores reales.

# Cerebro del agente. Capa gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Canal. Token que entrega @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=

# Cadena aleatoria propia. Telegram la reenvía en cada webhook y nosotros la
# comparamos: sin esto, cualquiera puede inyectar mensajes falsos al bot.
TELEGRAM_WEBHOOK_SECRET=

# Basic Auth del panel del dueño (usuario: admin).
PANEL_PASSWORD=
