{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuno",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Un Durable Object por conversación: aislamiento y concurrencia por diseño.
  // "new_sqlite_classes" (y no "new_classes") es obligatorio — el plan gratuito de
  // Workers solo admite Durable Objects con backend SQLite.
  "durable_objects": {
    "bindings": [{ "name": "AGENTE", "class_name": "AgenteConversacion" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgenteConversacion"] }],

  // Archivos estáticos (la imagen del hero, y mañana los logos de marca blanca).
  // Los sirve la CDN de Cloudflare antes de despertar al Worker, así que no
  // cuestan invocación y no hay que meterlos en base64 dentro del HTML — un PNG
  // de 1 MB incrustado son ~1.4 MB de HTML que el navegador no puede cachear
  // aparte, en una página que se abre desde un mostrador con la señal que haya.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Las fotos del catálogo. KV y no R2 porque R2 exige registrar una tarjeta
  // aunque no se pase del tramo gratuito, y KV viene incluido en el plan de
  // Workers. La consistencia eventual de KV (hasta un minuto) es irrelevante
  // para una foto de producto.
  "kv_namespaces": [{ "binding": "IMAGENES", "id": "12af6afe77424d449473ab1e85834a66" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuno",
      "database_id": "50f72126-740e-4813-8c9c-355ca32a8698"
    }
  ],

  // Dos triggers a propósito. Un único cron diario dejaría al vigía sin poder
  // detectar nada: revisa promesas contra la fecha de hoy y tiene que correr
  // durante el día, no de madrugada.
  "triggers": {
    "crons": [
      "*/30 * * * *", // vigía de promesas
      "0 7 * * *" // purga de mensajes viejos (2 a.m. hora Colombia)
    ]
  },

  "vars": {
    "NOMBRE_BOT": "CHUNO",
    "LLM_PROVEEDOR": "gemini",
    // En orden de preferencia; si uno se jubila o agota su cuota, cae al
    // siguiente. Verificados contra la capa gratuita el 2026-07-29.
    "MODELOS_LLM": "gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest",
    "BUFFER_SEGUNDOS": "15",
    "RETENCION_DIAS": "90",
    // Dos negocios separados a propósito: la demo pública nunca muestra las
    // conversaciones reales que entran por Telegram.
    "NEGOCIO_DEMO": "demo-optica",
    "NEGOCIO_TELEGRAM": "mi-optica"
  }

  // Secretos (nunca aquí — `wrangler secret put <NOMBRE>`):
  //   GEMINI_API_KEY            cerebro del agente
  //   TELEGRAM_BOT_TOKEN        canal
  //   TELEGRAM_WEBHOOK_SECRET   valida que el webhook viene de Telegram
  //   PANEL_PASSWORD            Basic Auth del panel del dueño
}
